# Supabase project (public — used by the browser client)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase service role key — server-only, never exposed to the browser.
# Used for privileged admin actions (creating auth users, resetting passwords).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# IANA timezone used for all telework-rule date math.
APP_TIMEZONE=Africa/Casablanca
